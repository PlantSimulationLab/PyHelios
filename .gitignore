# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Auto-generated version file (setuptools-scm)
pyhelios/_version.py

# Compiled stub extensions (built from _stub.c by setuptools)
pyhelios/_stub.cpython-*.so
pyhelios/_stub.cpython-*.pyd

# Note: All other generated files (libraries, assets) are kept in pyhelios_build/
# and are NOT in the source tree, so they don't need gitignore entries

# Auto-generated documentation
docs/generated/

# Output written by the example scripts (safe to delete)
docs/examples/output/

# IDEs and editors
.vscode/
.idea/
*.pydevproject
*.project
*.settings/
*.tmproj
*.esproj
*.sublime-workspace
*.sublime-project

# Miscellaneous
*.bak
*.backup
*.swp
*.tmp
*.log
*.cache
*.DS_Store
*.orig
*.rej
*.~*

# Auto-synced WeberPennTree resources (automatically maintained)
/plugins/

# MCP memory server files (local development only)
.aim/
.mcp.json
# Runtime plugin assets staged by build_helios.py (compiled shaders, CMake scratch).
# Generated output belongs under pyhelios_build/build/; this path is a staging copy.
/pyhelios_build/plugins/
